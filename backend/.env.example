# Production Atlas V1 uses your existing Supabase PostgreSQL connection string.
# Replace these placeholders; credentials must never be put in VITE_* variables.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:REPLACE_ME@POOLER_HOST:5432/postgres
# DATABASE_URL is required; there is no implicit SQLite fallback.
# For local development only, explicitly select: sqlite:///libris.db
# Existing catalogues: see ../docs/PHASE1_DATABASE.md before starting the server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render production override (comma-separated exact origins, no trailing slash):
# CORS_ORIGINS=https://libotsystems.netlify.app

# Authentication remains fail-closed until explicitly configured and enabled.
# See AUTH.md for mandatory Supabase Dashboard / OTP email template setup.
AUTH_ENABLED=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Legacy SUPABASE_ANON_KEY is also accepted. Never use service_role / sb_secret_*.
# Generate independently using the commands in AUTH.md; never use these placeholders.
AUTH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AUTH_SECURITY_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_ENV=production
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Direct Netlify -> Render cookie authentication requires AUTH_COOKIE_SAMESITE=none
# with AUTH_COOKIE_SECURE=true. Same-site deployments should keep lax.
# Production also requires HTTPS CORS_ORIGINS. For localhost ONLY, explicitly use:
# AUTH_ENV=development
# AUTH_COOKIE_SECURE=false

# Configurable initial guardrails, NOT finalized product policies.
AUTH_SESSION_SECONDS=604800
AUTH_IDLE_SECONDS=1800
AUTH_RECOVERY_SECONDS=600
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_IP_LIMIT=30
AUTH_EMAIL_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
AUTH_EMAIL_SEND_LIMIT=3
AUTH_EMAIL_SEND_WINDOW_SECONDS=60
# OTP expiry, resend cooldown, code length, password policy and additional upstream
# limits are configured in Supabase Auth, not invented or overridden by this API.

# Exact-route shelf guidance is opt-in. See GUIDANCE.md; test firmware first.
GUIDANCE_ENABLED=false
# Owner/server-provisioned verified staff UUIDs; not a multi-library roles system.
AUTH_STAFF_USER_IDS=
# Unique random >=32-character secret per robot, provisioned securely in firmware.
ATLAS_DEVICE_KEYS={}
